<h2><%= l(:label_settings) %></h2>

<% tabs = project_settings_tabs.map do |tab|
     url = settings_project_path(@project, tab: tab[:name])
     if tab[:name] == 'issue_limits_warning'
       tab.merge(url: url)
     else
       {name: tab[:name], label: tab[:label], url: url}
     end
   end %>
<%= render_tabs tabs, 'issue_limits_warning' %>

<% html_title(l(:label_settings)) %>
