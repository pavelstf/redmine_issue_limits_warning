<span class="rilw-badge <%= result.css_class %>" style="--rilw-color: <%= h(result.color) %>">
  <span class="rilw-badge-label"><%= l(:label_rilw_time_budget) %></span>
  <span><%= l(:label_rilw_cpi) %>: <%= result.cpi ? format('%.2f', result.cpi) : l(:label_rilw_unavailable) %></span>
  <span><%= result.done_ratio %>% · <%= result.spent_hours.round(2) %>/<%= result.estimated_hours.round(2) %> h</span>
  <% if result.reason %><span><%= l("label_rilw_reason_#{result.reason}".to_sym) %></span><% end %>
  <% if result.forecast_hours %>
    <span><%= l(:label_rilw_forecast, hours: result.forecast_hours.round(1)) %></span>
    <% if result.done_ratio.to_f < 10 %><span><%= l(:label_rilw_provisional) %></span><% end %>
  <% end %>
  <% if result.absolute_limit_reached %><span class="rilw-badge-note"><%= l(:label_rilw_absolute_reached) %></span><% end %>
  <% if result.exceeded? %><span><%= l(:label_rilw_exceeded_by, hours: result.exceeded_hours.round(2)) %></span><% end %>
</span>
