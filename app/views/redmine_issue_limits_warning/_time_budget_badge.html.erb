<% format_hours = ->(value) { format('%.2f', value.to_f).sub(/\.?0+\z/, '') } %>
<% format_ratio = ->(value) { "#{value.to_f.round}%" } %>
<span class="rilw-badge <%= result.css_class %>" style="--rilw-color: <%= h(result.color) %>">
  <span class="rilw-badge-label"><%= l(:label_rilw_time_budget) %></span>
  <span class="rilw-badge-value">
    <%= format_hours.call(result.spent_hours) %>/<%= format_hours.call(result.estimated_hours) %> h
    (<%= format_ratio.call(result.ratio) %>)
  </span>
  <% if result.exceeded? %>
    <span class="rilw-badge-note"><%= l(:label_rilw_exceeded_by, hours: format_hours.call(result.exceeded_hours)) %></span>
  <% elsif result.warning? || result.danger? %>
    <span class="rilw-badge-note"><%= l("label_rilw_status_#{result.status}".to_sym) %></span>
  <% end %>
</span>
