<% entry = local_assigns[:time_entry] || @time_entry %>
<% issue = entry.try(:issue) || @issue %>
<div class="rilw-time-entry-warning" role="status" aria-live="polite"
     data-context-url="<%= rilw_time_entry_context_path %>"
     data-issue-id="<%= issue.try(:id) %>" data-entry-id="<%= entry.try(:id) %>"
     data-cpi-message="<%= l(:notice_rilw_cpi_entry) %>"
     data-limit-message="<%= l(:label_rilw_absolute_reached) %>"></div>
