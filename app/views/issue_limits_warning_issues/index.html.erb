<h2><%= l(:label_issue_limits_warning) %>: <%= l("label_rilw_filter_#{@status}".to_sym) %></h2>

<p><%= link_to l(:label_project), project_path(@project) %>: <%= link_to_project(@project) %></p>

<% if @issues.any? %>
  <table class="list issues odd-even rilw-filtered-issues">
    <thead>
      <tr>
        <th>#</th>
        <th><%= l(:field_tracker) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:field_subject) %></th>
        <th><%= l(:field_assigned_to) %></th>
        <th><%= l(:field_estimated_hours) %></th>
        <th><%= l(:label_spent_time) %></th>
        <th><%= l(:field_due_date) %></th>
      </tr>
    </thead>
    <tbody>
      <% @issues.each do |issue| %>
        <tr id="issue-<%= issue.id %>" class="<%= cycle('odd', 'even') %> issue">
          <td class="id"><%= link_to_issue issue, subject: false %></td>
          <td class="tracker"><%= h(issue.tracker) %></td>
          <td class="status"><%= h(issue.status) %></td>
          <td class="subject"><%= link_to_issue issue %></td>
          <td class="assigned_to"><%= h(issue.assigned_to) %></td>
          <td class="estimated_hours"><%= issue.estimated_hours %></td>
          <td class="spent_hours"><%= issue.spent_hours %></td>
          <td class="due_date"><%= format_date(issue.due_date) if issue.due_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <span class="pagination"><%= pagination_links_full @issue_pages, @issue_count %></span>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
