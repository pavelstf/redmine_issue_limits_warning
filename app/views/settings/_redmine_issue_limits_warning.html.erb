<% settings = RedmineIssueLimitsWarning::Settings.global.merge(settings.slice(*RedmineIssueLimitsWarning::Settings::DEFAULTS.keys)) %>
<fieldset class="box tabular">
  <legend><%= l(:label_rilw_time_budget_settings) %></legend>
  <p class="info"><%= l(:help_rilw_cpi) %></p>
  <% %w[time_budget_enabled absolute_limit_enabled due_date_enabled show_on_issue_show show_on_issue_list show_ok_issue_list_marker show_on_project_overview warn_on_time_entry].each do |key| %>
    <p><label for="settings_<%= key %>"><%= l("field_rilw_#{key}".to_sym) %></label>
      <%= hidden_field_tag "settings[#{key}]", '0', id: nil %>
      <%= check_box_tag "settings[#{key}]", '1', RedmineIssueLimitsWarning::Settings.truthy?(settings[key]) %></p>
  <% end %>
  <% %w[cpi_warning cpi_danger absolute_limit_threshold].each do |key| %>
    <p><label for="settings_<%= key %>"><%= l("field_rilw_#{key}".to_sym) %></label>
      <%= number_field_tag "settings[#{key}]", settings[key], min: 0.0001, max: key == 'absolute_limit_threshold' ? 999 : 1, step: 'any', required: true %></p>
  <% end %>
  <p class="info"><%= l(:help_rilw_thresholds) %></p>
  <% %w[ok_color warning_color danger_color overdue_color].each do |key| %>
    <p><label for="settings_<%= key %>"><%= l("field_rilw_#{key}".to_sym) %></label>
      <%= color_field_tag "settings[#{key}]", settings[key] %></p>
  <% end %>
</fieldset>
